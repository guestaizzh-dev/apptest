{
  "name": "gui-er-xue-zhi-pc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "归途智学教师课堂 Windows 客户端",
  "author": "归途智学",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "electron .",
    "desktop:build": "vue-tsc --build && vite build --mode desktop && electron-builder --win portable --x64",
    "desktop:build:mac": "vue-tsc --build && vite build --mode desktop && electron-builder --config electron-builder.mac.cjs --mac zip --x64 --arm64",
    "desktop:build:mac:unsigned": "vue-tsc --build && vite build --mode desktop && python scripts/package-macos-unsigned.py",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src scripts docs vite.config.ts env.d.ts package.json .prettierrc.json",
    "format:check": "prettier --check src scripts docs vite.config.ts env.d.ts package.json .prettierrc.json",
    "check:conventions": "node scripts/check-conventions.mjs",
    "test:architecture": "node scripts/verify-architecture.mjs",
    "test:auth": "node scripts/verify-auth.mjs",
    "test:rtc": "node scripts/verify-rtc.mjs",
    "test:board-capture": "node scripts/verify-board-capture.mjs",
    "test:schedule": "node scripts/verify-schedule.mjs",
    "test:teacher-home": "node scripts/verify-teacher-home.mjs",
    "check": "run-s format:check check:conventions test:architecture test:auth test:teacher-home test:schedule test:rtc test:board-capture type-check"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zego-express-engine-webrtc": "^3.12.0",
    "zego-superboard-web": "^2.20.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "less": "^4.9.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.xueerguitu.teacher.test",
    "productName": "归途智学教师端",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "归途智学教师端.exe"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
